# Copiar a .env y ajustar. NUNCA commitear el .env real.

# URL base del servidor. Si no se define, se usa el ultimo de .jasper-hosts
# y, en su defecto, el de desarrollo. Produccion (10.6.206.114:20022) NO se
# usa desde este toolkit.
# JASPER_URL=http://10.6.206.57:8080/jasperserver

# Usuario (la contrasena SIEMPRE se pide con read -s; nunca se guarda).
# JASPER_USER=

# Cookie jar de sesion (permisos 600). Default: ./.jasper-session
# JASPER_COOKIE_JAR=

# Carpetas de trabajo (default: ./reportes y ./backups)
# JASPER_REPORTES_DIR=./reportes
# JASPER_BACKUPS_DIR=./backups
